---
import { localizedPath, useTranslations, type Locale } from '../i18n';
import { projectSlug, type Project } from '../lib/projects';
import Phone from './Phone.astro';
import StatList from './StatList.astro';
import TagList from './TagList.astro';

interface Props {
  project: Project;
  index: number;
  lang: Locale;
}

const { project, index, lang } = Astro.props;
const { title, tagline, stack, stats, accent, screenshots } = project.data;
const t = useTranslations(lang);
const href = localizedPath(lang, `/${projectSlug(project)}/`);
const cover = screenshots.slice(0, 2);
---

<article class:list={['card', { 'has-cover': cover.length > 0 }]} style={`--accent: ${accent}`}>
  <p class="index kicker">{String(index + 1).padStart(2, '0')}</p>
  <div class="body">
    <h3 class="title">
      <a href={href}>{title}</a>
    </h3>
    <p class="tagline">{tagline}</p>
    {stats.length > 0 && <StatList stats={stats} compact />}
    <TagList items={stack} />
    <p class="open" aria-hidden="true">
      {t.projects.open} <span>→</span>
    </p>
  </div>
  {cover.length > 0 && (
    <div class="cover" aria-hidden="true">
      {cover.map((shot) => (
        <Phone src={shot.src} alt="" sizes="(min-width: 56rem) 12rem, 40vw" />
      ))}
    </div>
  )}
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-m) var(--space-xl);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 56rem) {
    .card {
      grid-template-columns: 4rem minmax(0, 1fr);
    }

    .card.has-cover {
      grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 0.8fr);
    }
  }

  .index::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-left: 0.5em;
    background: var(--accent);
    border-radius: 50%;
  }

  .body {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .title {
    font-size: var(--step-4);
  }

  /* Toda la tarjeta es clicable a través del enlace del título. */
  .title a {
    text-decoration: none;
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .card:has(.title a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .tagline {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .open {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .open span {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .card:hover .open span {
    transform: translateX(0.3em);
  }

  .cover {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
    align-self: center;
    max-width: 26rem;
  }

  .cover > :global(:nth-child(2)) {
    translate: 0 var(--space-xl);
  }

  @media (prefers-reduced-motion: reduce) {
    .open span {
      transition: none;
    }
  }
</style>

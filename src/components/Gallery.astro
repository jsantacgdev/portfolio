---
import type { ImageMetadata } from 'astro';
import Phone from './Phone.astro';

interface Props {
  heading: string;
  shots: { src: ImageMetadata; alt: string; caption?: string | undefined }[];
}

const { heading, shots } = Astro.props;
---

<section class="gallery-section" aria-labelledby="screens-heading">
  <h2 id="screens-heading" class="section-title">
    {heading}
  </h2>
  <ul role="list" class="gallery" tabindex="0" aria-label={heading}>
    {shots.map((shot) => (
      <li>
        <figure>
          <Phone src={shot.src} alt={shot.alt} sizes="(min-width: 56rem) 14rem, 62vw" />
          {shot.caption && <figcaption>{shot.caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Móvil: carrusel deslizable que ocupa todo el ancho de la pantalla. */
  .gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62%;
    gap: var(--space-l);
    margin-top: var(--space-l);
    margin-inline: calc(-1 * var(--gutter));
    padding: var(--space-xs) var(--gutter) var(--space-l);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
  }

  li {
    scroll-snap-align: start;
  }

  figcaption {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  /* Escritorio: rejilla, sin desplazamiento. */
  @media (min-width: 56rem) {
    .gallery {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
      grid-auto-columns: auto;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
</style>

---
// Bloque para las decisiones técnicas dentro del MDX de cada proyecto:
// <Decision title="…">texto</Decision>. Se numeran solas (01, 02…).
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="decision">
  <h3>{title}</h3>
  <slot />
</section>

<style>
  .decision {
    counter-increment: decision;
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .decision + :global(.decision) {
    margin-top: var(--space-xl);
  }

  h3 {
    font-size: var(--step-2);
  }

  h3::before {
    content: counter(decision, decimal-leading-zero);
    display: block;
    margin-bottom: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .decision > :global(* + *) {
    margin-top: var(--space-s);
  }
</style>

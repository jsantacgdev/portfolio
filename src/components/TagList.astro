---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul role="list" class="tags">
  {items.map((item) => (
    <li>{item}</li>
  ))}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  li {
    padding: 0.15em 0.6em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-2);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
</style>

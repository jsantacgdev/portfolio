---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  layout: 'trio' | 'duo';
  items: { label: string; src?: ImageMetadata | undefined; alt?: string | undefined }[];
}

const { lang, layout, items } = Astro.props;
const t = useTranslations(lang);
const sizes =
  layout === 'trio' ? '(min-width: 48rem) 24rem, 72vw' : '(min-width: 48rem) 40rem, 55vw';
---

<ul role="list" class:list={['screens', layout]}>
  {items.map((item) => {
    const caption = `${t.projects.screenshot} · ${item.label}`;
    return (
      <li class="phone">
        {item.src ? (
          <Picture
            src={item.src}
            alt={item.alt ?? caption}
            sizes={sizes}
            widths={[320, 480, 720, 960]}
            formats={['avif', 'webp']}
          />
        ) : (
          <div class="placeholder">
            <Icon name="image" size={36} />
            <span>{caption}</span>
          </div>
        )}
      </li>
    );
  })}
</ul>

<style>
  .phone {
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    background: var(--phone);
    border: 2px solid var(--phone-border);
    border-radius: 10% / 4.6%;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.75);
  }

  .phone :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 1rem;
    font-size: clamp(0.8rem, 0.7rem + 0.4vw, 1.1rem);
    font-weight: 500;
    text-align: center;
    color: var(--muted);
    border: 1px dashed rgb(255 255 255 / 0.12);
    border-radius: inherit;
    margin: 0.6rem;
    height: calc(100% - 1.2rem);
  }

  /* Tres móviles escalonados: el central sube y el tercero baja. */
  .trio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding-block: 4.5rem;
  }

  .trio .phone:nth-child(2) {
    translate: 0 -4.5rem;
  }

  .trio .phone:nth-child(3) {
    translate: 0 4.5rem;
  }

  /* En pantallas estrechas, tres móviles no caben: carrusel deslizable. */
  @media (max-width: 48rem) {
    .trio {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 72%;
      margin-inline: calc(-1 * var(--gutter));
      padding: 1rem var(--gutter) 2.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .trio .phone {
      scroll-snap-align: start;
      translate: none !important;
    }
  }

  /* Uno grande y otro más pequeño, alineados abajo y el segundo algo más alto. */
  .duo {
    display: grid;
    grid-template-columns: 1.34fr 1fr;
    align-items: end;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .duo .phone:nth-child(2) {
    margin-bottom: clamp(2rem, 7vw, 6rem);
  }
</style>

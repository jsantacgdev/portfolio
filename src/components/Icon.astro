---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import Award from '@lucide/astro/icons/award';
import Bell from '@lucide/astro/icons/bell';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import ChartColumn from '@lucide/astro/icons/chart-column';
import Database from '@lucide/astro/icons/database';
import ImageIcon from '@lucide/astro/icons/image';
import KeyRound from '@lucide/astro/icons/key-round';
import ListOrdered from '@lucide/astro/icons/list-ordered';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Newspaper from '@lucide/astro/icons/newspaper';
import NotebookPen from '@lucide/astro/icons/notebook-pen';
import Percent from '@lucide/astro/icons/percent';
import ScanText from '@lucide/astro/icons/scan-text';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Shirt from '@lucide/astro/icons/shirt';
import Sparkles from '@lucide/astro/icons/sparkles';
import Table from '@lucide/astro/icons/table';
import Trophy from '@lucide/astro/icons/trophy';
import UserRound from '@lucide/astro/icons/user-round';
import UsersRound from '@lucide/astro/icons/users-round';
import type { IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const lucide = {
  'arrow-down': ArrowDown,
  award: Award,
  bell: Bell,
  calendar: CalendarDays,
  chart: ChartColumn,
  database: Database,
  image: ImageIcon,
  key: KeyRound,
  'list-ordered': ListOrdered,
  mail: Mail,
  'map-pin': MapPin,
  newspaper: Newspaper,
  notebook: NotebookPen,
  percent: Percent,
  scan: ScanText,
  shield: ShieldCheck,
  shirt: Shirt,
  sparkles: Sparkles,
  table: Table,
  trophy: Trophy,
  user: UserRound,
  users: UsersRound,
} as const;

// Lucide ya no incluye logos de marcas: GitHub y LinkedIn van dibujados aquí,
// con el mismo trazo que el resto.
const brands = {
  github: [
    'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4',
    'M9 18c-4.51 2-5-2-7-2',
  ],
  linkedin: [
    'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z',
    'M2 9h4v12H2z',
    'M4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z',
  ],
} as const;

const brandPaths = name === 'github' || name === 'linkedin' ? brands[name] : undefined;
const LucideIcon = name in lucide ? lucide[name as keyof typeof lucide] : undefined;
---

{brandPaths ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={className}
  >
    {brandPaths.map((d) => (
      <path d={d} />
    ))}
  </svg>
) : (
  LucideIcon && <LucideIcon size={size} stroke-width={1.75} aria-hidden="true" class={className} />
)}

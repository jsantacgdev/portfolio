---
// Vercel sirve este archivo para cualquier ruta inexistente. Como no sabemos en qué
// idioma llega el visitante, se muestran los dos.
import '@fontsource-variable/inter';
import '../styles/global.css';
import { SITE } from '../config';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — {SITE.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="wrap">
      <p class="kicker">404</p>
      <div lang="es">
        <h1>Esta página no existe.</h1>
        <a class="btn btn-primary" href="/es/">
          Ir al inicio
        </a>
      </div>
      <div lang="en">
        <h1>This page doesn’t exist.</h1>
        <a class="btn btn-secondary" href="/en/">
          Go to the home page
        </a>
      </div>
    </main>
  </body>
</html>

<style>
  main {
    display: grid;
    gap: 3rem;
    align-content: center;
    min-height: 100vh;
  }

  h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
</style>
